  "description": "AI占卜大师 - 八字、卦象、奇门、紫微斗数",
  "main": "www/index.html",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-kb-bundles.mjs && vite build && node scripts/build-web.mjs",
